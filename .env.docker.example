# Переменные для docker compose. Скопировать в .env рядом с docker-compose.yml.
# Только для локальной разработки — никаких настоящих секретов.

# Порты на хосте. 5433/6380 выбраны, чтобы не конфликтовать с локально
# установленными PostgreSQL (5432) и Redis (6379).
DB_PORT_HOST=5433
REDIS_PORT_HOST=6380
WEB_PORT_HOST=8000

DB_NAME=vote_db
DB_USER=vote_user
DB_PASSWORD=vote_password

# Dev-ключ. В production отсутствие DJANGO_SECRET_KEY обязано валить старт (этап 7).
DJANGO_SECRET_KEY=dev-only-insecure-key
