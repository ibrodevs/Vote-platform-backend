# ==============================================================================
# Production Environment Configuration Template (.env.example)
# Target Server: Hetzner Cloud HEL1 — CCX33 (8 vCPU, 32 GB RAM, 240 GB NVMe)
# ==============================================================================
# 1. cp .env.example .env
# 2. Generate strong secrets and fill DJANGO_SECRET_KEY/DB_PASSWORD/REDIS_PASSWORD.
# 3. Never commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE & DEPLOYMENT STAGE
# ------------------------------------------------------------------------------
DJANGO_ENV=production
DEPLOYMENT_STAGE=bootstrap
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=
API_DOMAIN=

# ------------------------------------------------------------------------------
# 2. DATABASE & PGBOUNCER
# ------------------------------------------------------------------------------
DB_ENGINE=postgresql
DB_NAME=vote_db
DB_USER=vote_user
DB_PASSWORD=
DB_HOST=pgbouncer
DB_PORT=5432
DB_BEHIND_PGBOUNCER=True
# Keep 0 unless server-side cursors are explicitly disabled and the persistent
# connection configuration has been validated in production.
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT=10
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=25
# DB_REPLICA_HOST=
# DB_REPLICA_PORT=5432

# ------------------------------------------------------------------------------
# 3. REDIS CACHE
# ------------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/1
# 2 GB leaves room for 300k warmed principals plus application cache.
REDIS_MAXMEMORY=2gb
REDIS_CONNECT_TIMEOUT=0.2
REDIS_SOCKET_TIMEOUT=0.2
# Warm 5–10 minutes before opening. 30 minutes avoids mass expiry at 12:00.
AUTH_PRINCIPAL_CACHE_TTL=1800

# Separate persistent broker; never share allkeys-lru cache with Celery queues.
REDIS_BROKER_MAXMEMORY=512mb
CELERY_BROKER_URL=redis://:<REDIS_PASSWORD>@redis-broker:6379/0
CELERY_RESULT_BACKEND=redis://:<REDIS_PASSWORD>@redis-broker:6379/1

# ------------------------------------------------------------------------------
# 4. CELERY
# ------------------------------------------------------------------------------
CELERY_TASK_ALWAYS_EAGER=False
CELERY_PREFETCH=1
CELERY_SOFT_TIME_LIMIT=600
CELERY_TIME_LIMIT=900
CELERY_DEFAULT_CONCURRENCY=4
CELERY_HEAVY_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 5. SECURITY, CORS & CSRF
# ------------------------------------------------------------------------------
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
USE_X_FORWARDED_FOR=True
TRUSTED_PROXY_COUNT=1
MOCK_SMS=False
STUDENT_TOKEN_ALLOW_MISSING_AUTH_VERSION=True

# ------------------------------------------------------------------------------
# 6. GUNICORN WSGI SERVER — CCX33 election-day baseline
# ------------------------------------------------------------------------------
GUNICORN_BIND=0.0.0.0:8000
WEB_CONCURRENCY=16
GUNICORN_THREADS=6
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=50000
GUNICORN_MAX_REQUESTS_JITTER=5000
GUNICORN_BACKLOG=8192
GUNICORN_KEEPALIVE=15
GUNICORN_PRELOAD=True
# "off" is handled by gunicorn.conf.py and really disables the access logger.
GUNICORN_ACCESS_LOG=off
GUNICORN_LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# 7. RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_AUTH=20/min
RATE_LIMIT_OTP_VERIFY=10/min
RATE_LIMIT_STUDENT=120/min
RATE_LIMIT_VOTE=20/min

# ------------------------------------------------------------------------------
# 8. NGINX & REVERSE PROXY
# ------------------------------------------------------------------------------
NGINX_CONF_FILE=http.conf
ADMIN_ALLOWED_IP=

# ------------------------------------------------------------------------------
# 9. STATIC / MEDIA
# ------------------------------------------------------------------------------
DJANGO_MEDIA_SHARED=True
DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY & METRICS
# ------------------------------------------------------------------------------
LOG_FORMAT=json
LOG_LEVEL=INFO
METRICS_ENABLED=True
METRICS_TOKEN=
PROMETHEUS_MULTIPROC_DIR=/dev/shm/prometheus
DJANGO_ADMIN_PATH=admin-django

# Exact request counters stay on. Expensive duration histogram and INFO request
# logging are sampled on election day. Set 1.0/1.0/True while diagnosing.
HTTP_METRICS_DURATION_SAMPLE_RATE=0.10
HTTP_ACCESS_LOG_SAMPLE_RATE=0.01
HTTP_IN_PROGRESS_METRIC_ENABLED=False

# ------------------------------------------------------------------------------
# 11. BACKUPS & DISASTER RECOVERY
# ------------------------------------------------------------------------------
S3_BACKUP_BUCKET=
RETENTION_DAYS=14
