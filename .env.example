# ==============================================================================
# Production Environment Configuration Template (.env.example)
# Target Server: Hetzner Cloud HEL1 — CCX33 (8 vCPU, 32 GB RAM, 240 GB NVMe)
# ==============================================================================
# ИНСТРУКЦИЯ ПО НАЧАЛЬНОЙ НАСТРОЙКЕ:
#   1. Скопируйте файл: cp .env.example .env
#   2. Сгенерируйте стойкие пароли и ключи (минимум 64 символа):
#        python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   3. Заполните сгенерированные значения в DJANGO_SECRET_KEY, DB_PASSWORD, REDIS_PASSWORD.
#   4. На первом этапе (до подключения домена) укажите:
#        DEPLOYMENT_STAGE=bootstrap
#        DJANGO_ALLOWED_HOSTS=<SERVER_IP>
#        DJANGO_CORS_ALLOWED_ORIGINS=http://<FRONTEND_IP_OR_HOST>
#        NGINX_CONF_FILE=http.conf
#   5. В Git файл .env коммитить СТРОГО ЗАПРЕЩЕНО!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE & DEPLOYMENT STAGE
# ------------------------------------------------------------------------------
DJANGO_ENV=production

# Режим развёртывания (ТЗ п.3, 32, 33):
#   - 'bootstrap'  : первый запуск по IP сервера (HTTP). SSL-редирект выключен,
#                    проверка secure-кук адаптирована, Nginx работает без TLS.
#   - 'production' : штатный боевой режим с доменом и TLS (HTTPS).
DEPLOYMENT_STAGE=bootstrap

# Обязательный секретный ключ для подписи JWT и сессий.
# Сгенерируйте: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=False

# Разрешённые хосты через запятую.
# Для bootstrap: укажите IP сервера (например: 195.201.12.34).
# Для domain: добавьте домен (например: 195.201.12.34,api.yourdomain.kg).
# ВНИМАНИЕ: символ '*' в production запрещён!
DJANGO_ALLOWED_HOSTS=

# Боевой домен бэкенда (ТЗ п.3, 4).
# Обязателен при DEPLOYMENT_STAGE=production (например: api.yourdomain.kg).
# Для bootstrap режима (по IP) можно оставить пустым.
API_DOMAIN=

# ------------------------------------------------------------------------------
# 2. DATABASE & PGBOUNCER (PostgreSQL 16)
# ------------------------------------------------------------------------------
DB_ENGINE=postgresql
DB_NAME=vote_db
DB_USER=vote_user

# Пароль базы данных.
# Сгенерируйте: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DB_PASSWORD=

# В production подключение идёт через PgBouncer (порт 5432 пулера)
DB_HOST=pgbouncer
DB_PORT=5432

# ПАРА НАСТРОЕК ДЛЯ PGBOUNCER (ТЗ п.6, 11):
# При transaction pooling соединения Django обязаны закрываться (CONN_MAX_AGE=0),
# а признак DB_BEHIND_PGBOUNCER=True должен быть явно объявлен.
DB_BEHIND_PGBOUNCER=True
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT=10

# Настройки пула PgBouncer
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=25

# Реплика чтения (ТЗ п.46) — опционально для будущего выноса на отдельный сервер
# DB_REPLICA_HOST=
# DB_REPLICA_PORT=5432

# ------------------------------------------------------------------------------
# 3. REDIS (Cache & Celery Broker)
# ------------------------------------------------------------------------------
# Пароль для Redis (требуется для подключения к брокеру и кэшу).
# Сгенерируйте: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
REDIS_PASSWORD=

# URL для Django кэша (БД 1) и брокера Celery (БД 0)
# Замените <REDIS_PASSWORD> на сгенерированный пароль:
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/1

REDIS_MAXMEMORY=256mb
REDIS_CONNECT_TIMEOUT=0.2
REDIS_SOCKET_TIMEOUT=0.2
AUTH_PRINCIPAL_CACHE_TTL=900

# ------------------------------------------------------------------------------
# 4. CELERY
# ------------------------------------------------------------------------------
# Замените <REDIS_PASSWORD> на сгенерированный пароль:
CELERY_BROKER_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
CELERY_RESULT_BACKEND=redis://:<REDIS_PASSWORD>@redis:6379/0

# В production обязательно False
CELERY_TASK_ALWAYS_EAGER=False
CELERY_PREFETCH=1
CELERY_SOFT_TIME_LIMIT=600
CELERY_TIME_LIMIT=900

# Конфигурация воркеров под CCX33 (ТЗ п.26)
CELERY_DEFAULT_CONCURRENCY=4
CELERY_HEAVY_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 5. SECURITY, CORS & CSRF
# ------------------------------------------------------------------------------
# Список доверенных origins фронтенда через запятую.
# ВНИМАНИЕ: wildcard '*' запрещён! Укажите реальный origin фронтенда.
# Пример: http://195.201.12.34:3000 или https://vote.yourdomain.kg
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# SSL Redirect: в bootstrap-режиме (HTTP) False, при подключении TLS — True
DJANGO_SSL_REDIRECT=False

# HSTS (включать только при подтверждённом работающем TLS на боевом домене)
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Прокси и заголовки
USE_X_FORWARDED_FOR=True
TRUSTED_PROXY_COUNT=1

# В production SMS-мок выключен (ТЗ п.34)
MOCK_SMS=False
STUDENT_TOKEN_ALLOW_MISSING_AUTH_VERSION=True

# ------------------------------------------------------------------------------
# 6. GUNICORN WSGI SERVER (ТЗ п.13)
# ------------------------------------------------------------------------------
GUNICORN_BIND=0.0.0.0:8000
# Стартовая конфигурация под CCX33 (8 vCPU): 4 воркера × 4 потока
WEB_CONCURRENCY=4
GUNICORN_THREADS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=2000
GUNICORN_MAX_REQUESTS_JITTER=200
GUNICORN_BACKLOG=1024
GUNICORN_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 7. RATE LIMITING (ТЗ п.16, 36)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_AUTH=20/min
RATE_LIMIT_OTP_VERIFY=10/min
RATE_LIMIT_STUDENT=120/min
RATE_LIMIT_VOTE=20/min

# ------------------------------------------------------------------------------
# 8. NGINX & REVERSE PROXY
# ------------------------------------------------------------------------------
# Режим Nginx:
#   - 'http.conf'  : initial deployment по IP (без TLS)
#   - 'https.conf' : production domain c TLS
NGINX_CONF_FILE=http.conf

# Ограничение доступа к Django Admin по IP / VPN (ТЗ п.10):
# Если задан, доступ к /admin-django/ и /admin/ будет разрешён только с указанного IP/подсети.
# Пример: 198.51.100.25 или 198.51.100.0/24
# Оставьте пустым для сохранения открытого доступа без ограничения IP.
ADMIN_ALLOWED_IP=

# ------------------------------------------------------------------------------
# 9. СТАТИКА И МЕДИАХРАНИЛИЩЕ (ТЗ п.24, 25)
# ------------------------------------------------------------------------------
# Для начальной одиночной ноды (локальный Docker volume):
# ВНИМАНИЕ: при переходе на несколько нод необходимо подключить S3!
DJANGO_MEDIA_SHARED=True

DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/

# S3-совместимое хранилище (Hetzner Object Storage / MinIO / AWS S3)
# При заполнении этих полей хранилище автоматически переключается на S3:
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY & METRICS (ТЗ п.27, 28)
# ------------------------------------------------------------------------------
LOG_FORMAT=json
LOG_LEVEL=INFO

# Prometheus metrics: закрыты от публичного доступа токеном
METRICS_ENABLED=True
# Сгенерируйте: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=
PROMETHEUS_MULTIPROC_DIR=/dev/shm/prometheus

# Административная панель Django (скрытый путь)
DJANGO_ADMIN_PATH=admin-django

# ------------------------------------------------------------------------------
# 11. BACKUPS & DISASTER RECOVERY (ТЗ п.8, 9, 29)
# ------------------------------------------------------------------------------
# S3-совместимый бакет для резервных копий (AWS S3 / Hetzner Storage Box).
# Если задан, scripts/backup.sh будет выгружать дампы во внешнее хранилище.
# При ошибке выгрузки скрипт завершится с ошибкой (exit != 0).
# Пример: s3://vote-platform-backups
S3_BACKUP_BUCKET=
BACKUP_RETENTION_DAYS=14
