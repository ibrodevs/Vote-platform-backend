# ==============================================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ (ТЗ п.101)
# ==============================================================================
# Здесь только placeholder'ы. Настоящие значения в Git не попадают никогда.
# Прежний ключ из репозитория скомпрометирован — используйте новый (ТЗ п.33).

# ------------------------------------------------------------------ DJANGO ---
# production включает строгие проверки: без корректных значений ниже
# приложение не стартует. Это намеренно.
DJANGO_ENV=production

# Обязателен. Им подписываются студенческие JWT: зная его, можно выпустить
# токен любого студента. Не короче 32 байт.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Обязателен в production. Wildcard запрещён.
DJANGO_ALLOWED_HOSTS=api.example.kg

DJANGO_DEBUG=False

# ---------------------------------------------------------------- DATABASE ---
DB_ENGINE=postgresql
DB_NAME=vote_db
DB_USER=vote_user
DB_PASSWORD=
# В production — адрес PgBouncer, а не самой PostgreSQL
DB_HOST=pgbouncer
DB_PORT=5432
# 0 обязателен при transaction pooling в PgBouncer: persistent-соединения
# со стороны Django уничтожают смысл пулера (ТЗ п.13)
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT=10

# ------------------------------------------------------------------- REDIS ---
REDIS_URL=redis://:пароль@redis:6379/1
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
# Короткие таймауты: при недоступном Redis мы идём в PostgreSQL,
# и ждать его секундами недопустимо
REDIS_CONNECT_TIMEOUT=0.2
REDIS_SOCKET_TIMEOUT=0.2
AUTH_PRINCIPAL_CACHE_TTL=900

# ------------------------------------------------------------------ CELERY ---
CELERY_BROKER_URL=redis://:пароль@redis:6379/0
CELERY_RESULT_BACKEND=redis://:пароль@redis:6379/0
# В production обязательно False, иначе импорт студентов выполнится
# внутри web-процесса и заблокирует воркер
CELERY_TASK_ALWAYS_EAGER=False
CELERY_PREFETCH=1
CELERY_SOFT_TIME_LIMIT=600
CELERY_TIME_LIMIT=900

# ---------------------------------------------------------------- SECURITY ---
# Wildcard запрещён; перечислите origin'ы фронтенда через запятую
DJANGO_CORS_ALLOWED_ORIGINS=https://vote.example.kg
DJANGO_CSRF_TRUSTED_ORIGINS=https://vote.example.kg

DJANGO_SSL_REDIRECT=True
# HSTS включайте ТОЛЬКО когда TLS точно работает на всех поддоменах:
# ошибка здесь делает сайт недоступным на срок действия заголовка
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# X-Forwarded-For подделывается тривиально. Доверять ему можно, только если
# приложение недоступно напрямую и стоит за известным прокси (ТЗ п.60)
USE_X_FORWARDED_FOR=True
TRUSTED_PROXY_COUNT=1

# В production обязательно False: в demo-режиме код подтверждения одинаков
# для всех студентов, и войти можно под любым (ТЗ п.34)
MOCK_SMS=False

# Выключить после окончания migration period: токены, выпущенные до
# появления auth_version, живут 7 дней
STUDENT_TOKEN_ALLOW_MISSING_AUTH_VERSION=True

# ------------------------------------------------------------------- MEDIA ---
# Задание бакета включает S3-совместимое хранилище. Без него — локальные файлы.
# ВАЖНО: фронтенд приклеивает относительный путь к origin API, поэтому
# бэкенд обязан отдавать абсолютные URL (docs/FRONTEND_USAGE.md)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/

# --------------------------------------------------------------- GUNICORN ---
# Ничего не захардкожено под конкретную машину. Правильные значения
# определяются бенчмарком, а не формулой (ТЗ п.38)
GUNICORN_BIND=0.0.0.0:8000
WEB_CONCURRENCY=4
GUNICORN_THREADS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=2000
GUNICORN_MAX_REQUESTS_JITTER=200
GUNICORN_BACKLOG=1024
GUNICORN_LOG_LEVEL=info

# ----------------------------------------------------------- OBSERVABILITY ---
# Заполняется на этапе 9
