# ==============================================================================
# ПРИМЕР ПЕРЕМЕННЫХ ОКРУЖЕНИЯ ДЛЯ BACKEND (PYTHONANYWHERE / PRODUCTION)
# ==============================================================================

# Секретный ключ Django (сгенерируйте уникальную строку для продакшна)
DJANGO_SECRET_KEY=vote-platform-secret-key-prod-change-me-34e8bb

# Режим отладки: False для продакшна (или True для первичной проверки)
DJANGO_DEBUG=False

# Разрешенные хосты (по умолчанию '*' разрешает любые домены)
DJANGO_ALLOWED_HOSTS=*

# База данных: 'sqlite' (рекомендуется для PythonAnywhere) или 'mysql' / 'postgresql'
DB_ENGINE=sqlite

# Если используется MySQL на PythonAnywhere:
# DB_ENGINE=mysql
# DB_NAME=username$vote_db
# DB_USER=username
# DB_PASSWORD=your_mysql_password
# DB_HOST=username.mysql.pythonanywhere-services.com
# DB_PORT=3306

# Фоновые задачи: на PythonAnywhere без Redis оставляем True (синхронное выполнение)
CELERY_TASK_ALWAYS_EAGER=True

# SMS верификация: True для эмуляции кодов (код 123456)
MOCK_SMS=True

# Дополнительные доверенные адреса для CSRF (через запятую)
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.pythonanywhere.com,https://*.vercel.app
