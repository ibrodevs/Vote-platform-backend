# ==============================================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ (ТЗ п.101)
# ==============================================================================
# Здесь только placeholder'ы. Настоящие значения в Git не попадают никогда.
# Прежний ключ из репозитория скомпрометирован — используйте новый (ТЗ п.33).

# ------------------------------------------------------------------ DJANGO ---
# production включает строгие проверки: без корректных значений ниже
# приложение не стартует. Это намеренно.
DJANGO_ENV=production

# Обязателен. Им подписываются студенческие JWT: зная его, можно выпустить
# токен любого студента. Не короче 32 байт.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Обязателен в production. Wildcard запрещён.
DJANGO_ALLOWED_HOSTS=api.example.kg

DJANGO_DEBUG=False

# ---------------------------------------------------------------- DATABASE ---
DB_ENGINE=postgresql
DB_NAME=vote_db
DB_USER=vote_user
DB_PASSWORD=
# В production — адрес PgBouncer, а не самой PostgreSQL
DB_HOST=pgbouncer
DB_PORT=5432
# Эти две переменные задаются ПАРОЙ. Django не может определить, стоит ли
# перед ним пулер — PgBouncer выглядит для него обычным PostgreSQL, — поэтому
# схему нужно заявить явно, иначе production_check не пропустит деплой.
#
#   Схема 1, рекомендуемая (ТЗ п.13):  DB_BEHIND_PGBOUNCER=True,  DB_CONN_MAX_AGE=0
#   Схема 2, без пулера:               DB_BEHIND_PGBOUNCER=False, DB_CONN_MAX_AGE=60
#
# Цена ошибки измерена на этапе 11, профиль записи голосов, одна нагрузка:
# CONN_MAX_AGE=0 без пулера дал p95 364 мс, с CONN_MAX_AGE=60 — 13 мс.
# Без пулера Django закрывает соединение после каждого запроса, и PostgreSQL
# на каждый следующий заново порождает backend-процесс.
DB_BEHIND_PGBOUNCER=True
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT=10

# Реплика чтения (ТЗ п.46). Пока переменная не задана, реплики нет вовсе
# и все запросы идут в primary — это безопасное состояние по умолчанию.
#
# Появление реплики НЕ перенаправляет чтения автоматически: на неё уходят
# только запросы, помеченные в коде вызовом eventual() — новости, FAQ,
# статические страницы, справочник вузов. Голосование, статус голосования
# и операции со статусом выборов всегда читают primary, иначе студент
# может увидеть «вы ещё не голосовали» после успешного голоса.
# DB_REPLICA_HOST=postgres-standby
# DB_REPLICA_PORT=5432

# Медиафайлы при нескольких репликах (ТЗ п.99). Загрузка, попавшая на одну
# ноду, не существует для остальных, поэтому production требует явного выбора:
# объектное хранилище (задать AWS_STORAGE_BUCKET_NAME) либо общий сетевой
# каталог, заявленный этой переменной.
DJANGO_MEDIA_SHARED=False

# ------------------------------------------------------------------- REDIS ---
REDIS_URL=redis://:пароль@redis:6379/1
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
# Короткие таймауты: при недоступном Redis мы идём в PostgreSQL,
# и ждать его секундами недопустимо
REDIS_CONNECT_TIMEOUT=0.2
REDIS_SOCKET_TIMEOUT=0.2
AUTH_PRINCIPAL_CACHE_TTL=900

# ------------------------------------------------------------------ CELERY ---
CELERY_BROKER_URL=redis://:пароль@redis:6379/0
CELERY_RESULT_BACKEND=redis://:пароль@redis:6379/0
# В production обязательно False, иначе импорт студентов выполнится
# внутри web-процесса и заблокирует воркер
CELERY_TASK_ALWAYS_EAGER=False
CELERY_PREFETCH=1
CELERY_SOFT_TIME_LIMIT=600
CELERY_TIME_LIMIT=900

# ---------------------------------------------------------------- SECURITY ---
# Wildcard запрещён; перечислите origin'ы фронтенда через запятую
DJANGO_CORS_ALLOWED_ORIGINS=https://vote.example.kg
DJANGO_CSRF_TRUSTED_ORIGINS=https://vote.example.kg

DJANGO_SSL_REDIRECT=True
# HSTS включайте ТОЛЬКО когда TLS точно работает на всех поддоменах:
# ошибка здесь делает сайт недоступным на срок действия заголовка
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# X-Forwarded-For подделывается тривиально. Доверять ему можно, только если
# приложение недоступно напрямую и стоит за известным прокси (ТЗ п.60)
USE_X_FORWARDED_FOR=True
TRUSTED_PROXY_COUNT=1

# В production обязательно False: в demo-режиме код подтверждения одинаков
# для всех студентов, и войти можно под любым (ТЗ п.34)
MOCK_SMS=False

# Выключить после окончания migration period: токены, выпущенные до
# появления auth_version, живут 7 дней
STUDENT_TOKEN_ALLOW_MISSING_AUTH_VERSION=True

# ------------------------------------------------------------------- MEDIA ---
# Задание бакета включает S3-совместимое хранилище. Без него — локальные файлы.
# ВАЖНО: фронтенд приклеивает относительный путь к origin API, поэтому
# бэкенд обязан отдавать абсолютные URL (docs/FRONTEND_USAGE.md)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/

# --------------------------------------------------------------- GUNICORN ---
# Ничего не захардкожено под конкретную машину. Правильные значения
# определяются бенчмарком, а не формулой (ТЗ п.38)
GUNICORN_BIND=0.0.0.0:8000
WEB_CONCURRENCY=4
GUNICORN_THREADS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=2000
GUNICORN_MAX_REQUESTS_JITTER=200
GUNICORN_BACKLOG=1024
GUNICORN_LOG_LEVEL=info

# ------------------------------------------------------- RATE LIMITING ---
# Выключается целиком для нагрузочного тестирования: иначе бенчмарк
# измеряет работу троттлера, а не приложения (ТЗ п.36)
RATE_LIMIT_ENABLED=True
# Ключ — IP. Только для операций до аутентификации
RATE_LIMIT_AUTH=20/min
RATE_LIMIT_OTP_VERIFY=10/min
# Ключ — СТУДЕНТ, не IP: за университетским NAT тысячи студентов,
# и лимит по адресу заблокировал бы их всех разом
RATE_LIMIT_STUDENT=120/min
RATE_LIMIT_VOTE=20/min

# ------------------------------------------------------------- DJANGO ADMIN ---
# Стандартный /admin/ находят сканеры за минуты. Настоящее ограничение
# доступа (VPN, allowlist по IP) настраивается на Nginx (ТЗ п.98)
DJANGO_ADMIN_PATH=admin-django

# ----------------------------------------------------------- OBSERVABILITY ---
# json в production: при нескольких репликах текстовые логи не разобрать
LOG_FORMAT=json
LOG_LEVEL=INFO
# Имя инстанса в логах. По умолчанию — hostname
INSTANCE_NAME=

# /metrics не выставляется наружу: он раскрывает объёмы и предварительные
# итоги голосования. Токен плюс ограничение по сети на Nginx
METRICS_ENABLED=True
METRICS_TOKEN=
# Общая директория для метрик воркеров gunicorn. Без неё скрейп попадает
# в один воркер и показывает его долю вместо общей картины
PROMETHEUS_MULTIPROC_DIR=/dev/shm/prometheus
